PORT=4000
CORS_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
OAUTH_CALLBACK_BASE_URL=http://localhost:4000

# Local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora_fusion?schema=public

# Supabase Postgres via connection pooling:
# 1. Supabase dashboard -> Connect -> ORMs / Prisma.
# 2. Replace [YOUR-PASSWORD] with the database password, then uncomment:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?schema=public

JWT_SECRET=replace-with-strong-secret
JWT_TTL=7d

# Server-only AI provider secrets. Never expose these as VITE_* or commit real keys.
OPENROUTER_API_KEY=replace-with-your-openrouter-key
OPENROUTER_MODEL=openai/gpt-4o-mini

# Captions/video transcription use OpenRouter by default when OPENROUTER_API_KEY is set.
TRANSCRIPTION_PROVIDER=openrouter
TRANSCRIPTION_MODEL=openai/whisper-large-v3

# Optional paid transcription providers:
# TRANSCRIPTION_PROVIDER=openai
# TRANSCRIPTION_MODEL=whisper-1
# Required only for transcription through OpenAI.
OPENAI_API_KEY=replace-with-your-openai-key

# Social login credentials. Add these from Google Cloud, Microsoft Entra, and GitHub OAuth apps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
