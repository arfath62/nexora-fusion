PORT=4000
CORS_ORIGIN=http://localhost:5173

# Local Postgres:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nexora_fusion?schema=public

# Supabase Postgres via connection pooling:
# 1. Supabase dashboard -> Connect -> ORMs / Prisma.
# 2. Replace [YOUR-PASSWORD] with the database password, then uncomment:
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public
# DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-1-[REGION].pooler.supabase.com:5432/postgres?schema=public

JWT_SECRET=replace-with-strong-secret
JWT_TTL=7d
